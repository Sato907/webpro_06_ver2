<!Doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title>おすすめ診断</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    * { box-sizing: border-box; }
    body {
      --c: #0984e3;
      font-family: "Helvetica Neue", system-ui, sans-serif;
      color: #1d1d2b; margin: 0; min-height: 100vh; padding: 56px 24px;
      background: radial-gradient(1200px 600px at 50% -10%, #ffffff, #e8f1fb 60%, #ddebf8 100%);
    }
    .wrap { max-width: 880px; margin: 0 auto; }

    .hero { text-align: center; margin-bottom: 40px; }
    .hero .eyebrow { display: inline-block; font-size: 12px; letter-spacing: .28em;
                     color: #6f8fb0; text-transform: uppercase; margin-bottom: 14px; }
    .hero h1 { margin: 0; font-size: 36px; font-weight: 800; letter-spacing: .02em;
               background: linear-gradient(90deg, var(--c), color-mix(in srgb, var(--c) 55%, #6c5ce7));
               -webkit-background-clip: text; background-clip: text; color: transparent; }
    .hero .bar { width: 64px; height: 4px; border-radius: 4px; margin: 18px auto 16px;
                 background: linear-gradient(90deg, var(--c), color-mix(in srgb, var(--c) 55%, #6c5ce7)); }
    .hero .lead { color: #4f6275; margin: 0 auto; max-width: 620px; font-size: 14.5px; line-height: 1.7; }

    .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; }
    .card {
      position: relative; overflow: hidden; display: flex; flex-direction: column;
      text-decoration: none; color: #fff; padding: 26px 24px 22px; border-radius: 18px;
      min-height: 160px;
      background: linear-gradient(140deg, var(--cc), color-mix(in srgb, var(--cc) 60%, #14223a));
      box-shadow: 0 10px 24px rgba(20,34,58,.16);
      transition: transform .18s ease, box-shadow .18s ease;
    }
    .card::before { content: ""; position: absolute; top: -48px; right: -48px; width: 150px; height: 150px;
                    border-radius: 50%; background: rgba(255,255,255,.16); transition: transform .35s ease; }
    .card::after { content: ""; position: absolute; bottom: -60px; left: -30px; width: 120px; height: 120px;
                   border-radius: 50%; background: rgba(255,255,255,.08); }
    .card:hover { transform: translateY(-6px); box-shadow: 0 18px 36px rgba(20,34,58,.28); }
    .card:hover::before { transform: scale(1.25); }
    .card .num { position: absolute; top: 16px; right: 20px; font-size: 34px; font-weight: 800;
                 color: rgba(255,255,255,.26); line-height: 1; }
    .card h2 { position: relative; margin: 0 0 8px; font-size: 21px; font-weight: 700; }
    .card p { position: relative; margin: 0; font-size: 13.5px; line-height: 1.65; color: rgba(255,255,255,.92); }
    .card .cta { position: relative; margin-top: auto; padding-top: 16px; font-size: 13px; font-weight: 600;
                 display: inline-flex; align-items: center; gap: 6px; }
    .card .arrow { transition: transform .18s ease; }
    .card:hover .cta .arrow { transform: translateX(4px); }

    .site-nav { margin-top: 44px; text-align: center; }
    .site-nav h3 { font-size: 14px; letter-spacing: .04em; color: #5d6b7a; margin-bottom: 14px; font-weight: 600; }
    .nav-btns { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
    .nav-btn { display: inline-block; text-decoration: none; padding: 10px 20px; border-radius: 999px;
               border: 1px solid #c3cdd8; background: rgba(255,255,255,.8); color: #44525f; font-size: 13.5px;
               transition: all .18s ease; }
    .nav-btn:hover { background: var(--c); border-color: var(--c); color: #fff; transform: translateY(-2px); }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="hero">
      <span class="eyebrow">Diagnosis</span>
      <h1>おすすめ診断</h1>
      <div class="bar"></div>
      <p class="lead">かんたんな質問に答えて、あなたにピッタリの一人を見つけよう。3種類の診断から選べます。</p>
    </div>

    <div class="cards">
      <% let i = 0; for (const key in sindan) { const c = sindan[key]; %>
        <a class="card" style="--cc: <%= c.color %>;" href="/sindan/<%= key %>">
          <span class="num"><%= String(i + 1).padStart(2, "0") %></span>
          <h2><%= c.title %></h2>
          <p><%= c.subtitle %></p>
          <span class="cta">診断をはじめる<span class="arrow">&rsaquo;</span></span>
        </a>
        <% i += 1; } %>
    </div>

    <div class="site-nav">
      <h3>各サイトの一覧ページへ</h3>
      <div class="nav-btns">
        <a class="nav-btn" href="/">← 各サイトの一覧に戻る</a>
        <a class="nav-btn" href="/manga">哲学者一覧</a>
        <a class="nav-btn" href="/kyouiku">教育学者一覧</a>
        <a class="nav-btn" href="/bisyoujo">美少女一覧</a>
      </div>
    </div>
  </div>
</body>
</html>

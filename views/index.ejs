<!Doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title>制作サイトまとめ</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: "Helvetica Neue", system-ui, sans-serif;
      color: #1d1d2b;
      margin: 0;
      min-height: 100vh;
      padding: 56px 24px;
      background: radial-gradient(1200px 600px at 50% -10%, #ffffff, #eceaf6 60%, #e4e1f2 100%);
    }
    .wrap { max-width: 880px; margin: 0 auto; }

    /* ヘッダー */
    .hero { text-align: center; margin-bottom: 44px; }
    .hero .eyebrow {
      display: inline-block; font-size: 12px; letter-spacing: .28em;
      color: #8a87a6; text-transform: uppercase; margin-bottom: 14px;
    }
    .hero h1 {
      margin: 0; font-size: 40px; font-weight: 800; letter-spacing: .02em;
      background: linear-gradient(90deg, #6c5ce7, #e84393);
      -webkit-background-clip: text; background-clip: text; color: transparent;
    }
    .hero .bar { width: 64px; height: 4px; border-radius: 4px; margin: 18px auto 16px;
                 background: linear-gradient(90deg, #6c5ce7, #e84393); }
    .hero .lead { color: #5d5b73; margin: 0; font-size: 15px; line-height: 1.7; }

    /* カード群 */
    .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; }
    .card {
      position: relative; overflow: hidden; display: flex; flex-direction: column;
      text-decoration: none; color: #fff; padding: 26px 24px 22px; border-radius: 18px;
      min-height: 168px;
      background: linear-gradient(140deg, var(--c), color-mix(in srgb, var(--c) 62%, #1a1a2e));
      box-shadow: 0 10px 24px rgba(31, 27, 60, .16);
      transition: transform .18s ease, box-shadow .18s ease;
    }
    /* 角の装飾円 */
    .card::before {
      content: ""; position: absolute; top: -48px; right: -48px; width: 150px; height: 150px;
      border-radius: 50%; background: rgba(255,255,255,.16);
      transition: transform .35s ease;
    }
    .card::after {
      content: ""; position: absolute; bottom: -60px; left: -30px; width: 120px; height: 120px;
      border-radius: 50%; background: rgba(255,255,255,.08);
    }
    .card:hover { transform: translateY(-6px); box-shadow: 0 18px 36px rgba(31, 27, 60, .28); }
    .card:hover::before { transform: scale(1.25); }

    .card .num {
      position: absolute; top: 16px; right: 20px; font-size: 34px; font-weight: 800;
      color: rgba(255,255,255,.28); line-height: 1; letter-spacing: .02em;
    }
    .card h2 { position: relative; margin: 0 0 8px; font-size: 22px; font-weight: 700; }
    .card p { position: relative; margin: 0; font-size: 13.5px; line-height: 1.65; color: rgba(255,255,255,.92); }
    .card .cta {
      position: relative; margin-top: auto; padding-top: 16px; font-size: 13px; font-weight: 600;
      display: inline-flex; align-items: center; gap: 6px; color: #fff;
    }
    .card .cta .arrow { transition: transform .18s ease; }
    .card:hover .cta .arrow { transform: translateX(4px); }

    footer { text-align: center; color: #9b99ad; margin-top: 44px; font-size: 12px; letter-spacing: .08em; }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="hero">
      <span class="eyebrow">Portfolio</span>
      <h1>制作サイトまとめ</h1>
      <div class="bar"></div>
      <p class="lead">これまでに制作した各サイトの一覧です。<br>カードを選ぶとそれぞれのサイトへ移動できます。</p>
    </div>

    <div class="cards">
      <% sites.forEach(function(s, i) { %>
        <a class="card" style="--c: <%= s.color %>;" href="<%= s.href %>">
          <span class="num"><%= String(i + 1).padStart(2, "0") %></span>
          <h2><%= s.title %></h2>
          <p><%= s.desc %></p>
          <span class="cta">サイトを開く<span class="arrow">&rsaquo;</span></span>
        </a>
      <% }); %>
    </div>

    <footer>WebPro06 期末課題</footer>
  </div>
</body>
</html>

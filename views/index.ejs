<!Doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title>制作サイトまとめ</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    body { font-family: system-ui, sans-serif; background: #f6f6fb; color: #222; margin: 0; padding: 24px; }
    .wrap { max-width: 760px; margin: 0 auto; }
    h1 { text-align: center; margin-bottom: 4px; }
    .lead { text-align: center; color: #666; margin-top: 0; }
    .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-top: 28px; }
    .card { display: block; text-decoration: none; color: #fff; padding: 24px; border-radius: 14px;
            box-shadow: 0 4px 12px rgba(0,0,0,.15); transition: transform .12s; }
    .card:hover { transform: translateY(-3px); }
    .card h2 { margin: 0 0 8px; font-size: 22px; }
    .card p { margin: 0; opacity: .92; font-size: 14px; line-height: 1.5; }
    footer { text-align: center; color: #999; margin-top: 36px; font-size: 13px; }
  </style>
</head>
<body>
  <div class="wrap">
    <h1>制作サイトまとめ</h1>
    <p class="lead">これまでに制作した各サイトの一覧です。カードから移動できます。</p>
    <div class="cards">
      <% sites.forEach(function(s) { %>
        <a class="card" style="background: <%= s.color %>;" href="<%= s.href %>">
          <h2><%= s.title %></h2>
          <p><%= s.desc %></p>
        </a>
      <% }); %>
    </div>
    <footer>WebPro06 期末課題</footer>
  </div>
</body>
</html>

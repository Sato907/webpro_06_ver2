<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= data.name  %></title>
  <link rel="stylesheet" href="/kyouiku.css">
  <style>
    .portrait-box { text-align: center; margin: 16px 0; }
    .portrait { max-width: 240px; width: 100%; height: auto; border: 1px solid #b9b9c6; border-radius: 6px; box-shadow: 0 2px 6px rgba(0,0,0,.15); }
    .portrait-cap { display: block; margin-top: 6px; color: #666; font-size: 14px; }
    a.work-link { color: #1a5fb4; text-decoration: underline; }
  </style>
</head>
<body>
  <h2><%= data.name %>の詳細</h2>

  <%# ▼▼ 追加：肖像画。画像が無い場合は NO IMAGE を表示 ▼▼ %>
  <div class="portrait-box">
    <img class="portrait"
         src="<%= data.img ? data.img : '/images/kyouiku/' + name + '.jpg' %>"
         alt="<%= data.name %>の肖像"
         onerror="this.onerror=null; this.src='/images/no_image.svg';">
    <span class="portrait-cap"><%= data.name %></span>
  </div>

  <table>
    <tr><th>項目</th><th>データ</th></tr>
    <%# ▼▼ 人名を日本語Wikipediaにリンク ▼▼ %>
    <tr><td>人物</td><td><a class="work-link" href="https://ja.wikipedia.org/wiki/<%= encodeURIComponent(data.name) %>" target="_blank" rel="noopener"><%= data.name %></a></td></tr>
    <tr><td>生誕</td><td><%= data.birth %></td></tr>
    <tr><td>死没</td><td><%= data.death %></td></tr>
    <%# ▼▼ 著作物を『』ごとに日本語Wikipediaにリンク ▼▼ %>
    <tr><td>著作物</td><td><%- data.book.replace(/『([^』]+)』/g, function(m, t){ return '<a class="work-link" href="https://ja.wikipedia.org/wiki/' + encodeURIComponent(t) + '" target="_blank" rel="noopener">『' + t + '』</a>'; }) %></td></tr>
    <tr><td>日本の教育への影響</td><td><%= data.study %></td></tr>
    <tr><td>関連するキーワード</td><td><%= data.key %></td></tr>
</table>
  <a href="/kyouiku">一覧に戻る</a>
  <a href="/kyouiku/delete/<%= name %>" onclick="return confirm('本当にこの教育思想家を削除してもよろしいですか？');">
    削除
  </a>
  <a href="/kyouiku/edit/<%= name %>">編集画面へ</a>
  <a href="/sindan/kyouiku">教育観診断</a>
</body>
</html>

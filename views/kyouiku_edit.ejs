<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= data.name %></title>
  <link rel="stylesheet" href="/kyouiku.css">
</head>
<body>
  <h2><%= data.name %>の編集</h2>
  <form action="/kyouiku/update/<%= name %>" method="POST" enctype="multipart/form-data">
    <table>
      <tr><th>項目</th><th>データ</th></tr>
      <tr><td>画像(jpg)</td><td>
        <div class="img-edit">
          <img class="img-preview"
               src="/images/kyouiku/<%= name %>.jpg"
               alt="現在の画像"
               onerror="this.onerror=null; this.src='/images/no_image.svg';">
          <input type="file" name="image" accept="image/jpeg">
          <p class="img-note">jpgファイルを選ぶと画像を差し替えます（未選択なら現状維持）。</p>
        </div>
      </td></tr>
      <tr><td>人物</td><td><input type="text" name="name" value="<%= data.name %>"></td></tr>
      <tr><td>生誕</td><td><input type="text" name="birth" value="<%= data.birth %>"></td></tr>
      <tr><td>死没</td><td><input type="text" name="death" value="<%= data.death %>"></td></tr>
      <tr><td>著作物</td><td><input type="text" name="book" value="<%= data.book %>"></td></tr>
      <tr><td>教育への影響</td><td><input type="text" name="study" value="<%= data.study %>"></td></tr>
      <tr><td>関連するキーワード</td><td><input type="text" name="key" value="<%= data.key %>"></td></tr>

    </table>

    

    
    <div class="submit-container">
        <input type="submit" value="登録" class ="common-btn">
    </div> 
  </form>
  <a href="/kyouiku">教育思想家一覧に戻る</a>
</body>
</html>
<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>ニーチェの登場人物一覧</title>
  <link rel="stylesheet" href="/manga.css">
</head>
</head>
<body>
  <h2>漫画「ニーチェが京都にやってきて17歳の私に哲学のことを教えてくれた。」の登場人物一覧</h2>
  <ul class="name-list">
    <% let number = 0 %>
    <% for( let row of data ) { %>
      <li>
        <a class="name-card" href="/manga/<%= number %>">
          <span class="name-text"><%= row.name %></span>
          <span class="arrow">›</span>
        </a>
      </li>
      <% number += 1 %>
    <% } %>
  </ul>
  <div class="page-nav">
    <a class="common-btn" href="/">← 各サイトの一覧に戻る</a>
    <a class="common-btn" href="/manga/create">新規登録</a>
    <% if (typeof sindan !== 'undefined') { %>
      <a class="common-btn" href="/sindan/<%= sindan %>">哲学者診断をする</a>
    <% } %>
  </div>


</body>
</html>
<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>教育原理で登場する主要な教育思想家一覧</title>
  <link rel="stylesheet" href="/kyouiku.css">
</head>
</head>
<body>
  <h2>教育原理で登場する主要な教育思想家一覧</h2>
  <ul class="name-list">
    <% let number = 0 %>
    <% for( let row of data ) { %>
      <li>
        <a class="name-card" href="/kyouiku/<%= number %>">
          <span class="name-text"><%= row.name %></span>
          <span class="arrow">›</span>
        </a>
      </li>
      <% number += 1 %>
    <% } %>
  </ul>
  <div class="page-nav">
    <a class="common-btn" href="/">← 各サイトの一覧に戻る</a>
    <a class="common-btn" href="/kyouiku/create">新規登録</a>
    <% if (typeof sindan !== 'undefined') { %>
      <a class="common-btn" href="/sindan/<%= sindan %>">教育観診断をする</a>
    <% } %>
  </div>


</body>
</html>
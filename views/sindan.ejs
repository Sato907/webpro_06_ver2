<!Doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <title><%= cfg.title %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>
    body { font-family: system-ui, sans-serif; background: #f6f6fb; color: #222; margin: 0; padding: 24px; }
    .wrap { max-width: 640px; margin: 0 auto; }
    h1 { text-align: center; color: <%= cfg.color %>; }
    .sub { text-align: center; color: #666; margin-top: -8px; }
    .q { background: #fff; border-radius: 12px; padding: 18px 20px; margin: 18px 0;
         box-shadow: 0 2px 8px rgba(0,0,0,.08); }
    .q h3 { margin: 0 0 12px; font-size: 17px; }
    label { display: block; padding: 10px 12px; margin: 6px 0; border: 1px solid #ddd; border-radius: 8px;
            cursor: pointer; transition: background .1s, border-color .1s; }
    label:hover { background: #faf5fb; }
    input[type=radio] { margin-right: 8px; }
    .submit { display: block; width: 100%; padding: 14px; font-size: 17px; color: #fff; border: none;
              border-radius: 10px; background: <%= cfg.color %>; cursor: pointer; margin-top: 8px; }
    .nav-btns { margin-top: 22px; display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
    .nav-btn { display: inline-block; text-decoration: none; padding: 10px 20px; border-radius: 8px;
               border: 1px solid <%= cfg.color %>; background: #fff; color: <%= cfg.color %>;
               font-size: 14px; transition: all .2s ease; }
    .nav-btn:hover { background: <%= cfg.color %>; color: #fff; }
  </style>
</head>
<body>
  <div class="wrap">
    <h1><%= cfg.title %></h1>
    <p class="sub"><%= cfg.subtitle %></p>

    <form action="/sindan/<%= category %>" method="post">
      <% cfg.questions.forEach(function(question, qi){ %>
        <div class="q">
          <h3>Q<%= qi + 1 %>. <%= question.q %></h3>
          <% question.options.forEach(function(opt, oi){ %>
            <label>
              <input type="radio" name="q<%= qi %>" value="<%= oi %>" <%= oi === 0 ? "checked" : "" %>>
              <%= opt.label %>
            </label>
          <% }); %>
        </div>
      <% }); %>
      <button class="submit" type="submit">診断する</button>
    </form>

    <div class="nav-btns">
      <a class="nav-btn" href="<%= cfg.basePath %>">← 一覧ページへ戻る</a>
      <a class="nav-btn" href="/sindan">診断トップへ</a>
    </div>
  </div>
</body>
</html>
